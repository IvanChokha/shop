# cp .env.example .env
# Для локального запуска всё работает и без этого файла: у переменных есть значения по умолчанию.

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Адрес MinIO, каким его видит БРАУЗЕР (картинки и presigned PUT). В проде — https-домен.
S3_PUBLIC_URL=http://localhost:9000

# --- API ---
# Токен для /api/v1/admin/* — обязательно сменить
ADMIN_TOKEN=change-me
# true, когда сайт открывается по https
COOKIE_SECURE=false

# --- Telegram-бот (профиль `bot`) ---
BOT_TOKEN=
# polling — только 1 реплика; webhook — 2+ реплик
BOT_MODE=polling
# Публичный https-адрес, на который проброшен nginx:8081 (нужен для webhook)
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-me-secret
CART_SECRET=change-me-too
